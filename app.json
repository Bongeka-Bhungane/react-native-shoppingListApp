{
  "expo": {
    "name": "ShoppingListApp",
    "slug": "ShoppingListApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/shoppingListIcon.jpg",
    "scheme": "shoppinglistapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/shoppinglistSplash.jpg",
        "backgroundImage": "./assets/images/shoppinglistSplash.jpg",
        "monochromeImage": "./assets/images/shoppinglistSplash.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bongeka.ShoppingListApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/shoppingListFavicon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/shoppingListSplash.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fb3be9b-b614-43ca-b888-1319cd33870e"
      }
    }
  }
}
